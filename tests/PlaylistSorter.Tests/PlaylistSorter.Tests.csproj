<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Dependency-free test runner (no NuGet restore needed) for the plugin's pure sorting code.
    It compiles the plugin's Sorting/*.cs directly, with LangVersion 8.0 to match the plugin so any newer syntax
    sneaking into those files fails here. Run:  dotnet run -c Release
    Kept outside emby-playlist-manager/ so the plugin's default globbing never compiles it into the shipped DLL.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>8.0</LangVersion>
    <Nullable>disable</Nullable>
    <RootNamespace>PlaylistSorter.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\emby-playlist-manager\Sorting\*.cs" Link="Sorting\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
